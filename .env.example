# ==============================================================================
# CampusPilot (Aegis Agent Runtime) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides, or set these variables in
# Render Dashboard under: Environment -> Environment Variables / Secret Files.
# Do NOT commit actual secrets or API keys to version control.
# ==============================================================================

# Core Runtime Settings
APP_NAME="CampusPilot Autonomous Agent Runtime"
ENVIRONMENT=production
DEBUG=false

# Port & Networking (Automatically assigned by Render, defaults to 10000)
# PORT=10000

# SQLite Database
# In Render Free web services, the container file system is ephemeral.
# SQLite database data resets when the free instance spins down after inactivity,
# restarts, or redeploys. For long-term persistent production storage, consider
# external PostgreSQL (e.g. Render PostgreSQL).
DATABASE_URL="sqlite+aiosqlite:///./aegis.db"

# Security & Cryptography
# Set persistent static keys in production to ensure tokens & nonces remain valid across restarts.
# AEGIS_ENCRYPTION_KEY: Fernet 32-byte urlsafe base64 key (e.g. from cryptography.fernet.Fernet.generate_key().decode())
AEGIS_ENCRYPTION_KEY=""

# HMAC_SECRET_KEY: 64-character hex string (e.g. from secrets.token_hex(32))
HMAC_SECRET_KEY=""

# Approval Nonce TTL in seconds (default: 600)
APPROVAL_TTL_SECONDS=600

# CORS Allowed Origins (JSON array format, optional)
# CORS_ORIGINS=["https://my-campuspilot.onrender.com"]

# Optional: Google Workspace Integration (Google Drive & Google Calendar Tools)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI: Defaults automatically to ${RENDER_EXTERNAL_URL}/api/auth/google/callback on Render
GOOGLE_REDIRECT_URI=""

# Optional: Gemini Planning Engine (Google GenAI SDK)
# If left blank, CampusPilot operates deterministically using the built-in offline topological planner.
GEMINI_API_KEY=""
